# Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# ======================
# App
# ======================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Event Platform"

# ======================
# Database (add when ready)
# ======================
# DATABASE_URL=postgresql://user:password@localhost:5432/event_platform

# ======================
# Authentication (add when ready)
# ======================
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# CLERK_SECRET_KEY=sk_test_xxx

# ======================
# File Upload (add when ready)
# ======================
# UPLOADTHING_TOKEN=xxx

# ======================
# Payment (add when ready)
# ======================
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
